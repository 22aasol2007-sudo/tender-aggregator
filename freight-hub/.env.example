# Freight Hub
HOST=127.0.0.1
PORT=8088
DB_PATH=data/hub.db
SCRAPE_INTERVAL_SEC=300
MIN_SCORE=40

# Keep loads at most N days (feed + DB cleanup + TG/MAX backfill)
# MAX_LOAD_AGE_DAYS=7
# CORS_ORIGINS=https://your-app.vercel.app

# Telegram ingest — hub owns the single Telethon session
ENABLE_TG=1
OWN_TELETHON=1
API_ID=
API_HASH=
# PHONE=+79001234567
SESSION_NAME=freight_hub
# MTProto proxy (without Happ): from t.me/proxy?server=&port=&secret=
# TG_PROXY_SERVER=127.0.0.1
# TG_PROXY_PORT=1443
# TG_PROXY_SECRET=
# Optional partner APIs (no public free feed without token)
ATI_API_TOKEN=
MONOPOLY_API_TOKEN=

# Protect write APIs on public URL (mute/profile/scrape/QR). Leave empty only for local.
# HUB_WRITE_TOKEN=change-me
# HUB_INJECT_UI_TOKEN=1
# Extra MAX join/channel URLs (comma-separated)
# MAX_EXTRA_CHANNELS=https://max.ru/join/xxxx,https://max.ru/some_channel
# Hot alerts via Telegram bot
# ALERT_BOT_TOKEN=
# ALERT_CHAT_ID=
# ALERT_MIN_SCORE=80
# ZERO_ADD_STREAK_WARN=3

# MAX messenger (unofficial user session via PyMax)
ENABLE_MAX=1
MAX_SESSION_NAME=freight_hub_max.db
# Only for login_max.py if account has 2FA password (remove after login)
# MAX_2FA_PASSWORD=
# Run: python login_max.py  → scan QR in MAX app

# Local: never share cloud TG session — keep ENABLE_TG=0 when cloud owns the key.
# ENABLE_TG=0
