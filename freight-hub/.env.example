# Freight Hub
HOST=127.0.0.1
PORT=8088
DB_PATH=data/hub.db
SCRAPE_INTERVAL_SEC=300
MIN_SCORE=40

# Telegram ingest — hub owns the single Telethon session
ENABLE_TG=1
OWN_TELETHON=1
API_ID=
API_HASH=
# PHONE=+79001234567
SESSION_NAME=freight_hub
# Optional partner APIs (no public free feed without token)
ATI_API_TOKEN=
MONOPOLY_API_TOKEN=

# MAX messenger (unofficial user session via PyMax)
ENABLE_MAX=1
MAX_SESSION_NAME=freight_hub_max.db
# Only for login_max.py if account has 2FA password (remove after login)
# MAX_2FA_PASSWORD=
# Run: python login_max.py  → scan QR in MAX app
