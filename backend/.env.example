HTTP_VERIFY_SSL=true
# Split timeouts help US/EU→RU: fail connect fast, allow slow EIS/ETP reads
HTTP_CONNECT_TIMEOUT=12
HTTP_READ_TIMEOUT=35
HTTP_RU_READ_TIMEOUT=45
HTTP_TIMEOUT=35
HTTP_RETRIES=2
# Optional RU egress proxy (also honour HTTP_PROXY / HTTPS_PROXY / ALL_PROXY)
# Prefer ISP/residential for zakupki.gov.ru — datacenter often gets empty/captcha.
# SCRAPE_PROXY_URL=http://user:pass@ru-proxy.example:8080
SCRAPE_PROXY_URL=
DATABASE_URL=postgresql+psycopg://tender:tender@127.0.0.1:5432/tenders
ALLOW_SQLITE_FALLBACK=false
DB_CONNECT_TIMEOUT=15
HIDE_OUTDATED_DEFAULT=true
# Legacy full-scrape interval (cold/full job). Hot/cold below are preferred.
SCRAPE_INTERVAL_MINUTES=3
# Hot: zakupki + b2b/fabrikant/otc/rostender (minutes, may be fractional e.g. 1.5)
HOT_SCRAPE_INTERVAL_MINUTES=1.5
# Cold: remaining scrape-capable sources
COLD_SCRAPE_INTERVAL_MINUTES=12
# EIS RSS/HTML pages per searchString pass when proxy/path works (1 on hard transport fail)
EIS_MAX_PAGES=8
SCRAPE_SOURCE_TIMEOUT_SECONDS=100
SCRAPE_CONCURRENCY=2
# true (default): API only enqueues scrape/monitor; run a separate worker:
#   python -m app.worker
# false: API/scheduler run scrapes in-process (not recommended in production)
SCRAPE_VIA_WORKER=true
# Never seed DEMO tenders in production
SEED_IF_EMPTY=false
JWT_SECRET=change-me
DEFAULT_ADMIN_EMAIL=admin@tender.local
DEFAULT_ADMIN_PASSWORD=admin123
TELEGRAM_BOT_TOKEN=
TELEGRAM_ENABLED=true
# Optional commercial APIs (env fallback). Admin can also set these in UI (Мониторинг);
# non-empty DB values win over env. Tokens are never returned in full via API.
# URL must be a JSON list/search endpoint, e.g. https://api.example.com/v1/tenders
CONTOUR_API_URL=
CONTOUR_API_TOKEN=
TENDERPLAN_API_URL=
TENDERPLAN_API_TOKEN=
TENDERLAND_API_URL=
TENDERLAND_API_TOKEN=
SYNAPSE_API_URL=
SYNAPSE_API_TOKEN=
# Optional OpenAI-compatible LLM for 5-min supplier shortlist (no prices)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
SHORTLIST_WEB_TIMEOUT_S=55
SHORTLIST_LIMIT_DEFAULT=12
SHORTLIST_INCLUDE_WEB_DEFAULT=true
